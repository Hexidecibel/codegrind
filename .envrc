# cush-tools — auto-loads secrets via bin/inject on cd, then exports into shell.
# Requires direnv (https://direnv.net) — run `direnv allow` in this dir to enable.
if command -v /home/hexi/local/src/cush-tools/bin/inject >/dev/null; then
  /home/hexi/local/src/cush-tools/bin/inject --no-prompt 2>/dev/null || true
fi
[ -f .env ] && dotenv
