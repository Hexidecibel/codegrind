#!/usr/bin/env bash
# Pre-generate the Study reading tracks (18 outlines + the first lessons of
# each) so the first bedtime session isn't a series of 15s waits. Thin wrapper
# around bin/warm-lessons.ts, like bin/seed-bank.
#
# Idempotent and resumable — anything already cached is skipped and never
# re-requested from the API. Safe to re-run after a partial failure.
#
#   bin/warm-lessons --dry-run       # report the plan, spend nothing
#   bin/warm-lessons                 # all 18 tracks, first 3 lessons each
#   bin/warm-lessons --topic trees   # one track only
set -euo pipefail

# Derived, not hardcoded: a clone anywhere else used to `cd` into the author's
# tree and warm THAT database. Same idiom as bin/build.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

# Same Node selection as bin/build / bin/deploy — better-sqlite3 is compiled
# against the ABI of whatever Node runs it.
# shellcheck source=lib/node.sh
source "$REPO/bin/lib/node.sh"
cg_require_node

# The service gets its env from systemd's EnvironmentFile; a CLI run has to load
# it itself (PORT, HOST, DATA_DIR, and ANTHROPIC_API_KEY if you keep one there).
# bin/setup writes this file; on the author's box cush-tools' bin/inject
# rewrites it. Absent is fine — a wizard-configured install keeps its key and
# its provider rows in the database, and the .ts entrypoint hydrates both.
if [[ -f "$REPO/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/.env"
  set +a
fi

exec npx tsx bin/warm-lessons.ts "$@"
