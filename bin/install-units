#!/usr/bin/env bash
# =============================================================================
# codegrind — render this machine's systemd units and install them
# =============================================================================
#
#   bin/install-units                     install everything, enable+start the timer
#   bin/install-units --status            what is installed, and whether it drifted
#   bin/install-units --print             render every unit to stdout, change nothing
#   bin/install-units --print codegrind.service   render just one
#
# THE UNITS IN deploy/ ARE TEMPLATES, NOT FILES TO COPY. They used to be one
# machine's units — `/home/hexi/local/src/codegrind`, `User=hexi`, and a pinned
# `/home/hexi/.nvm/versions/node/v22.22.0/bin` on the service PATH — and this
# script installed them verbatim with `sudo install`. Anyone else who cloned the
# repo and followed docs/operations.md got three units pointing at a directory
# that does not exist on their box, a user that may not exist either, and a
# failing timer. So the machine-specific values are now three placeholders,
# filled in here from the same sources every other script in bin/ already uses:
#
#   @CODEGRIND_REPO@      this script's own location, `..` — same line as bin/setup
#   @CODEGRIND_USER@      the invoking user (SUDO_USER first, so `sudo bin/…`
#                         still writes the real user and not `root`)
#   @CODEGRIND_NODE_BIN@  bin/lib/node.sh's answer, which is the ONLY place that
#                         knows which Node better-sqlite3 can be loaded under
#
# HOST-LOCAL CONFIGURATION IS NOT THIS SCRIPT'S BUSINESS. systemd drop-ins —
# /etc/systemd/system/<unit>.d/*.conf — are separate files that systemd merges
# over the unit, and nothing here reads, writes, lists or removes them. That is
# deliberate and load-bearing: the author's own box carries
# CODEGRIND_MODEL_DENY (a list of model ids that exist only on that machine's
# LLM router, one of which starved a Plex transcode) in
# codegrind.service.d/model-deny.conf. It must survive every deploy, and it must
# never end up in the repo, where it would be noise in everybody else's install.
# Anything of that shape belongs in a drop-in.
#
# These are SYSTEM units, not user units, matching codegrind.service, which has
# been a system unit since day one (`/etc/systemd/system/codegrind.service`,
# WantedBy=multi-user.target). A user timer would stop running whenever the
# session ends unless lingering is enabled, and the sandbox reaper needs to run
# on a headless box that nobody is logged into.
#
# Installing codegrind.service here is deliberate: deploy/ is the source of
# truth for that file too, and having one script that reconciles /etc with the
# repo is what stops the live unit and the committed one from drifting. Note
# that this REWRITES the installed unit — it does not restart the service, so a
# change to codegrind.service needs a `bin/restart` afterwards to take effect.
#
# Idempotent — safe to re-run after editing any template.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNIT_DIR=/etc/systemd/system
UNITS=(codegrind.service codegrind-reap.service codegrind-reap.timer)

# shellcheck source=lib/node.sh
source "${REPO_DIR}/bin/lib/node.sh"

# -----------------------------------------------------------------------------
# The three machine-specific values
# -----------------------------------------------------------------------------
# `cg_require_node` explains and exits if there is no usable Node, which is the
# right failure: a unit whose PATH points at a Node that segfaults better-sqlite3
# is a unit that boots into a crash loop, and finding that out here beats finding
# it out from `systemctl status` at 3am.
cg_require_node
UNIT_NODE_BIN="$(dirname "${CG_NODE_BIN}")"
# SUDO_USER first: `sudo bin/install-units` must still produce `User=you`, not
# `User=root`. The app needs the docker group, not privilege.
UNIT_USER="${SUDO_USER:-$(id -un)}"

# Render one template to stdout.
#
# Two transformations and nothing else, so a directive in the template is a
# directive in /etc:
#   * `##` lines — notes to whoever edits the template — are dropped. Ordinary
#     `#` comments survive, because several of them record real incidents (see
#     codegrind-reap.timer, which explains the two containers that spun a core
#     for ten days).
#   * the three placeholders are substituted.
# `|` as the sed delimiter: every value here is a path.
render_unit() {
  local src="${REPO_DIR}/deploy/$1"
  [[ -f "$src" ]] || { echo "missing template ${src}" >&2; return 1; }
  cat <<EOF
# Generated by bin/install-units from deploy/$1 — edits here are lost on the
# next deploy. Host-local settings go in ${UNIT_DIR}/$1.d/*.conf drop-ins,
# which this script never touches.
EOF
  sed -e '/^##/d' \
      -e "s|@CODEGRIND_REPO@|${REPO_DIR}|g" \
      -e "s|@CODEGRIND_USER@|${UNIT_USER}|g" \
      -e "s|@CODEGRIND_NODE_BIN@|${UNIT_NODE_BIN}|g" \
      "$src"
}

# -----------------------------------------------------------------------------
# --print: render, change nothing. The way to see what would be installed, and
# to diff it against what is installed, without sudo and without touching /etc.
# -----------------------------------------------------------------------------
if [[ "${1:-}" == "--print" ]]; then
  if [[ -n "${2:-}" ]]; then
    render_unit "$2"
    exit 0
  fi
  for u in "${UNITS[@]}"; do
    printf '# ===== %s =====\n' "$u"
    render_unit "$u"
    echo
  done
  exit 0
fi

if [[ "${1:-}" == "--status" ]]; then
  for u in "${UNITS[@]}"; do
    if [[ -f "${UNIT_DIR}/${u}" ]]; then
      # Compared against the RENDERED unit, not the template: the template does
      # not match any machine and never will.
      if render_unit "$u" | diff -q - "${UNIT_DIR}/${u}" >/dev/null; then
        printf '  ok      %-26s installed, matches deploy/\n' "$u"
      else
        printf '  DRIFT   %-26s installed but DIFFERS from deploy/\n' "$u"
      fi
    else
      printf '  MISSING %-26s not installed\n' "$u"
    fi
    # Drop-ins are somebody's deliberate host-local config, so they are reported
    # rather than reconciled — a drop-in is never drift.
    if compgen -G "${UNIT_DIR}/${u}.d/*.conf" >/dev/null; then
      for c in "${UNIT_DIR}/${u}.d/"*.conf; do
        printf '  local   %-26s drop-in %s (host-local, left alone)\n' "$u" "$(basename "$c")"
      done
    fi
  done
  echo
  systemctl list-timers codegrind-reap.timer --all --no-pager
  exit 0
fi

echo "==> Rendering units for this machine"
echo "    repo      ${REPO_DIR}"
echo "    user      ${UNIT_USER}"
echo "    node      ${UNIT_NODE_BIN} (${CG_NODE_VERSION})"

echo "==> Installing units into ${UNIT_DIR}"
# Rendered to a private temp file first, then installed. `sudo install` from a
# pipe is not a thing, and writing directly into /etc leaves a half-written unit
# behind if the render fails halfway.
STAGE="$(mktemp -d)"
trap 'rm -rf "${STAGE}"' EXIT
for u in "${UNITS[@]}"; do
  render_unit "$u" > "${STAGE}/${u}"
  sudo install -m 0644 -o root -g root "${STAGE}/${u}" "${UNIT_DIR}/${u}"
  echo "    ${u}"
done

echo "==> Reloading systemd"
sudo systemctl daemon-reload

echo "==> Enabling the reaper timer"
# The TIMER is enabled, never the service: enabling a Type=oneshot service that
# a timer already activates makes it run once at boot for no reason and reports
# a confusing "inactive (dead)" state forever after.
sudo systemctl enable --now codegrind-reap.timer

echo "==> Proving it works right now"
sudo systemctl start codegrind-reap.service
sudo systemctl status codegrind-reap.service --no-pager | sed -n '1,12p' || true

echo
systemctl list-timers codegrind-reap.timer --all --no-pager
