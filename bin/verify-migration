#!/usr/bin/env bash
# Assert the database still says what it said before a schema migration.
#
# READ-ONLY. Opens SQLite with readonly:true and only ever GETs the API, so it
# is safe to run against the live service at any point — before a migration (to
# prove the baseline is real), and after (to prove nothing moved).
#
# Four layers, weakest first:
#   1. row counts      — catches a DROP, a failed copy, a duplicated rebuild
#   2. clean solves    — catches a WRONG JOIN, which row counts cannot see
#   3. tier credits    — the OTHER join (problems.topic/difficulty), plus the
#                        multi-language invariants once those columns exist
#   4. API payloads    — catches everything above plus the derivations on top
#
# Layer 2 is the one that earns its keep: the tier ladder is computed from a
# join of attempts to problems, and a migration that rebuilds either table with
# the columns in the wrong order leaves both row counts perfect.
#
#   bin/verify-migration              # all four layers
#   bin/verify-migration --db-only    # skip the API layer (service intentionally down)
#
# Exit: 0 = PASS, 1 = FAIL (something changed), 2 = INCOMPLETE (a check could
# not run — e.g. the service was unreachable and --db-only was not passed).

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR" || exit 2

# better-sqlite3 rather than a `sqlite3` CLI, so this script reads the database
# through exactly the library the app does. (The only sqlite3 binary on this host
# ships with the Android SDK, which is not a dependency anybody declared.) That
# native module is ABI-pinned, so lib/node.sh picks the Node it was built for.
# shellcheck source=lib/node.sh
source "$REPO_DIR/bin/lib/node.sh"
cg_require_node

# PORT / DATA_DIR live in .env for a CLI run; systemd hands them to the service.
if [[ -f "$REPO_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO_DIR/.env"
  set +a
fi

DB="${DATA_DIR:-$REPO_DIR/data}/codegrind.db"
PORT="${PORT:-9416}"
BASELINE_DIR="${BASELINE_DIR:-${HOME}/backups/codegrind/baseline}"

# -----------------------------------------------------------------------------
# Expected row counts — the known-good pre-migration state.
# -----------------------------------------------------------------------------
# Edit this table (and re-capture BASELINE_DIR) whenever the real numbers move
# because the user practiced, not because a migration ran.
# Moved at Phase 3 by real activity, not by a migration: +1 javascript problem
# and +8 seeded python problems (37 -> 46), +1 javascript and +1 python solve
# (63 -> 65), and the cold ('arrays','python') ladder (4 -> 5).
#
# Moved again at Phase 4's live verification, likewise by real activity: two
# bank misses generated a problem each (46 -> 48), and reading the Study feed in
# two languages had warmAhead write 15 lesson bodies (114 -> 129). `attempts` did
# NOT move, which is why /api/reflect stayed byte-identical across the phase.
#
# And again at Phase 4.5 (Go), all of it real activity rather than a migration —
# Go added NO schema (user_version is still 3, as it was before Python): 8 seeded
# go problems plus 1 javascript bank miss (48 -> 57), one go solve and one
# javascript solve (65 -> 67), and the cold ('arrays','go') ladder (5 -> 6). The
# byte-identical baseline diff was taken BEFORE any of this, against a capture
# made from the pre-change service; these numbers are the state it left behind.
#
# Moved once more by the first-run phase's regression smokes, again all real
# activity and no migration at all (this phase added NO schema; user_version is
# still 3): bin/smoke-e2e javascript banked one generated problem and filed one
# solve (57 -> 58, 67 -> 68). The byte-identical four-endpoint diff for that
# phase was taken BEFORE these ran, against baseline-firstrun; these numbers are
# the state they left behind.
#
# Moved once more by the provider-abstraction phase's regression smokes — again
# real activity, and again NO migration (user_version is still 3; that stage
# changed how a request is BUILT, never what is stored): bin/smoke-e2e
# javascript missed the bank, so it generated one problem and filed one solve
# (58 -> 59, 68 -> 69). bin/smoke-isolation and bin/dry-run-generate wrote
# nothing — the dry run is a dry run. The byte-identical four-endpoint diff for
# this stage was taken BEFORE any of them ran, against a baseline captured from
# the PRE-abstraction service and verified after the restart onto the new code;
# these numbers are the state the smokes left behind.
EXPECTED_ROWS=(
  "problems:59"
  "attempts:69"
  "skill_state:6"
  "sessions:8"
  "review_queue:11"
  "pattern_primers:18"
  "lesson_tracks:18"
  "lessons:129"
  "lesson_reads:19"
  "revealed_solutions:0"
)

# -----------------------------------------------------------------------------
# Fields excluded from the API diffs — genuinely time-varying, not schema.
# -----------------------------------------------------------------------------
# /activity      rolling 84-day window; every row shifts at UTC midnight
# /tiles/streak  day streak measured against today
# /*/reviewDue   counts `dueAt <= now`, so it ticks up on its own schedule
#                (there is a live queue row due within hours of this baseline)
REFLECT_IGNORE='["/activity","/tiles/streak","/tiles/reviewDue"]'
PROGRESS_IGNORE='["/reviewDue"]'
# /api/history and /api/study/index carry no clock-derived field at all: history
# is a list of stored attempts with their own stored timestamps, and the study
# index is the lesson corpus plus read receipts. Nothing to exclude, so nothing
# is — an empty ignore list is the strongest form of this check.
HISTORY_IGNORE='[]'
STUDY_INDEX_IGNORE='[]'

DB_ONLY=0
[[ "${1:-}" == "--db-only" ]] && DB_ONLY=1

FAILURES=0
INCOMPLETE=0

section() { printf '\n== %s\n' "$1"; }

printf 'codegrind :: verify-migration\n'
printf '  db       %s\n' "$DB"
printf '  baseline %s\n' "$BASELINE_DIR"
printf '  api      http://127.0.0.1:%s\n' "$PORT"

if [[ ! -f "$DB" ]]; then
  printf '\nFAIL: no database at %s\n' "$DB"
  exit 2
fi
if [[ ! -d "$BASELINE_DIR" ]]; then
  printf '\nFAIL: no baseline directory at %s\n' "$BASELINE_DIR"
  exit 2
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# -----------------------------------------------------------------------------
section "1. row counts"
# -----------------------------------------------------------------------------
EXPECTED_ROWS_TXT="$(printf '%s\n' "${EXPECTED_ROWS[@]}")"
export EXPECTED_ROWS_TXT DB
node -e '
const Database = require("better-sqlite3");
const db = new Database(process.env.DB, { readonly: true });
let bad = 0;
for (const line of process.env.EXPECTED_ROWS_TXT.trim().split("\n")) {
  const [table, want] = line.split(":");
  let got;
  try {
    got = db.prepare(`SELECT COUNT(*) AS n FROM "${table}"`).get().n;
  } catch (e) {
    console.log(`  FAIL ${table.padEnd(20)} unreadable — ${e.message}`);
    bad++;
    continue;
  }
  if (got === Number(want)) console.log(`  ok   ${table.padEnd(20)} ${got}`);
  else { console.log(`  FAIL ${table.padEnd(20)} expected ${want}, got ${got}`); bad++; }
}
console.log(`  user_version = ${db.pragma("user_version", { simple: true })}`);
db.close();
process.exit(bad ? 1 : 0);
'
[[ $? -ne 0 ]] && FAILURES=$((FAILURES + 1))

# -----------------------------------------------------------------------------
section "2. clean-solves aggregation"
# -----------------------------------------------------------------------------
# The tier ladder's only input, re-derived straight from SQL. Row counts are
# blind to a join that pairs the right number of rows with the wrong ones; this
# is not.
export CLEAN_BASELINE="$BASELINE_DIR/clean-solves.json"
node -e '
const fs = require("node:fs");
const Database = require("better-sqlite3");
const db = new Database(process.env.DB, { readonly: true });
const rows = db.prepare(`
  SELECT a.pattern AS topic, a.difficulty, COUNT(DISTINCT a.problemId) AS cleanSolves
  FROM attempts a WHERE a.solved = 1 AND a.hintsUsed = 0
  GROUP BY a.pattern, a.difficulty ORDER BY a.pattern, a.difficulty
`).all();
db.close();

const want = JSON.parse(fs.readFileSync(process.env.CLEAN_BASELINE, "utf8"));
const key = (r) => `${r.topic}/${r.difficulty}`;
const wantMap = new Map(want.map((r) => [key(r), r.cleanSolves]));
const gotMap = new Map(rows.map((r) => [key(r), r.cleanSolves]));

let bad = 0;
for (const k of new Set([...wantMap.keys(), ...gotMap.keys()])) {
  const w = wantMap.get(k), g = gotMap.get(k);
  if (w === g) continue;
  console.log(`  FAIL ${k.padEnd(28)} expected ${w ?? "(absent)"}, got ${g ?? "(absent)"}`);
  bad++;
}
if (!bad) console.log(`  ok   ${rows.length} (topic, difficulty) buckets match the baseline`);
process.exit(bad ? 1 : 0);
'
[[ $? -ne 0 ]] && FAILURES=$((FAILURES + 1))

# -----------------------------------------------------------------------------
section "3. tier credits + multi-language invariants"
# -----------------------------------------------------------------------------
# Layer 2 checks the attempts-only aggregation. This one checks the JOIN that
# `getCleanSolvesByTopic()` actually folds — a different join, on a different
# pair of columns — and then the language invariants, which only apply once the
# multi-language migration has run. Before it has, they are reported as pending
# rather than failed, so this script is meaningful on both sides of the change.
export CREDITS_BASELINE="$BASELINE_DIR/credits-by-topic.json"
node -e '
const fs = require("node:fs");
const Database = require("better-sqlite3");
const db = new Database(process.env.DB, { readonly: true });
let bad = 0;

const CREDITS = `
  SELECT p.topic AS key, p.language AS language, a.problemId AS problemId,
         p.difficulty AS difficulty, a.solved AS solved, a.hintsUsed AS hintsUsed
  FROM attempts a
  JOIN problems p ON p.id = a.problemId
`;
const ORDER = ` ORDER BY p.topic, p.language, a.problemId, p.difficulty, a.solved, a.hintsUsed`;

const has = (table, column) =>
  db.prepare(`PRAGMA table_info(${table})`).all().some((c) => c.name === column);

// --- tier credits, unfiltered: nothing moved -------------------------------
if (!fs.existsSync(process.env.CREDITS_BASELINE)) {
  console.log(`  SKIP tier credits — no credits-by-topic.json in the baseline`);
} else {
  const want = fs.readFileSync(process.env.CREDITS_BASELINE, "utf8").trim();
  const got = JSON.stringify(db.prepare(CREDITS + ORDER).all(), null, 2);
  if (got === want) console.log(`  ok   tier credit rows identical to the baseline`);
  else { console.log(`  FAIL tier credit rows differ from the baseline`); bad++; }

  // --- the behavioural check: the JS-filtered read must equal the JS baseline -
  // countCleanSolves is pure, so identical input rows are identical tier
  // credit. This is getCleanSolvesByTopic("javascript") === the javascript
  // rows of the baseline, proven without re-implementing the fold.
  //
  // Both sides are filtered. Before a second language was banked the baseline
  // WAS entirely javascript, so comparing the filtered read against the whole
  // file worked by accident; with python rows in the capture that comparison
  // starts failing for a reason that has nothing to do with javascript.
  if (has("problems", "language")) {
    const wantRows = JSON.parse(want);
    if (wantRows.length && wantRows[0].language === undefined) {
      console.log(`  ..   baseline predates the language column — re-capture it (bin/capture-baseline)`);
    } else {
      const wantJs = JSON.stringify(wantRows.filter((r) => r.language === "javascript"), null, 2);
      const gotJs = JSON.stringify(
        db.prepare(CREDITS + ` WHERE p.language = ?` + ORDER).all("javascript"), null, 2);
      if (gotJs === wantJs) console.log(`  ok   javascript-filtered tier credits match the baseline`);
      else { console.log(`  FAIL javascript-filtered tier credits differ from the baseline`); bad++; }
    }
  }
}

// --- language invariants ---------------------------------------------------
const LANG_TABLES = ["problems", "attempts", "sessions", "skill_state"];
const migrated = LANG_TABLES.every((t) => has(t, "language"));
if (!migrated) {
  console.log(`  ..   language columns not present yet — multi-language checks pending`);
} else {
  // Every row must carry a language this build KNOWS — not "javascript".
  //
  // Until Phase 3 those were the same assertion, because javascript was the
  // only language that could exist and "all rows javascript" was the strongest
  // statement available. Seeding a python bank makes that assertion false BY
  // DESIGN, and leaving it in place would turn the first correct multi-language
  // database into a migration failure. What still has to hold is that no row
  // carries NULL, empty, or a language outside the registry — which is what
  // catches a botched backfill or a stray hand-written UPDATE.
  // READ FROM src/shared/languages.ts RATHER THAN LISTED HERE. This was a
  // hardcoded ["javascript", "python", "java"] and Phase 4.5 walked straight
  // into it: adding Go made a perfectly correct database report eight rows
  // "with an unknown language", i.e. a migration failure that was really a
  // stale copy of a list. A verifier whose idea of the registry can drift from
  // the registry verifies the wrong thing, so it now parses the one source of
  // truth. (A regex rather than an import because this is plain CommonJS run
  // through `node -e`, and the registry is a `as const` tuple of literals —
  // the same reading src/shared/languages.test.ts does of the bash table.)
  //
  // NB the tokens are split and stripped rather than matched with a quoted
  // regex: this whole block is inside a single-quoted bash string, so a literal
  // apostrophe here ends the argument and bash tries to run the JavaScript.
  const registrySrc = require("node:fs").readFileSync("src/shared/languages.ts", "utf8");
  const tuple = /export const LANGUAGES = \[([^\]]*)\] as const;/.exec(registrySrc);
  if (!tuple) { console.log("  FAIL could not read LANGUAGES from src/shared/languages.ts"); bad++; }
  const KNOWN = tuple
    ? tuple[1].split(",").map((s) => s.replace(/[^a-z]/g, "")).filter(Boolean)
    : [];
  const placeholders = KNOWN.map(() => "?").join(", ");
  for (const t of LANG_TABLES) {
    const n = db.prepare(
      `SELECT COUNT(*) AS n FROM "${t}" WHERE language IS NULL OR language NOT IN (${placeholders})`
    ).get(...KNOWN).n;
    const breakdown = db.prepare(`SELECT language, COUNT(*) AS n FROM "${t}" GROUP BY language ORDER BY language`)
      .all().map((r) => `${r.language}=${r.n}`).join(" ");
    if (n === 0) console.log(`  ok   ${t.padEnd(20)} ${breakdown}`);
    else { console.log(`  FAIL ${t.padEnd(20)} ${n} row(s) with an unknown language (${breakdown})`); bad++; }
  }

  const pk = db.prepare(`PRAGMA table_info(skill_state)`).all()
    .filter((c) => c.pk > 0).sort((a, b) => a.pk - b.pk).map((c) => c.name).join(",");
  if (pk === "topic,language") console.log(`  ok   skill_state key is (topic, language)`);
  else { console.log(`  FAIL skill_state key is (${pk})`); bad++; }

  // The silent no-op: CREATE INDEX IF NOT EXISTS matches on name, so an index
  // that still lacks `language` is exactly what a skipped DROP looks like.
  const idx = db.prepare(`SELECT sql FROM sqlite_master WHERE name = ?`).get("idx_problems_slot");
  if (idx && /language/.test(idx.sql)) console.log(`  ok   idx_problems_slot carries language`);
  else { console.log(`  FAIL idx_problems_slot does not carry language: ${idx ? idx.sql : "(missing)"}`); bad++; }

  // v3: every problem must carry an explicit 0/1, and the pre-migration rows
  // must have been backfilled to 1 -- an un-backfilled row is invisible to the
  // bank filter, so the failure looks like "the bank is empty" rather than like
  // a migration bug.
  if (has("problems", "canonicalized")) {
    const malformed = db.prepare(
      `SELECT COUNT(*) AS n FROM problems WHERE canonicalized IS NULL OR canonicalized NOT IN (0, 1)`
    ).get().n;
    if (malformed === 0) console.log(`  ok   problems.canonicalized  every row is 0 or 1`);
    else { console.log(`  FAIL problems.canonicalized  ${malformed} row(s) neither 0 nor 1`); bad++; }

    const unverified = db.prepare(
      `SELECT COUNT(*) AS n FROM problems WHERE canonicalized = 0`
    ).get().n;
    const total = db.prepare(`SELECT COUNT(*) AS n FROM problems`).get().n;
    // Not a failure on its own -- JavaScript is allowed to store one when the
    // sandbox is down -- but it is always worth saying out loud.
    console.log(`  ok   problems servable       ${total - unverified}/${total} canonicalized`);
  } else {
    console.log(`  ..   problems.canonicalized not present yet -- v3 pending`);
  }

  // What `code_translations` must say about the CORPUS language.
  //
  // This check used to be a count: exactly one row per lesson-with-a-snippet
  // plus one per primer, 130 of them, which is what the Phase 1 backfill wrote.
  // Two things since made that number the wrong assertion, both of them normal
  // operation rather than damage:
  //
  //   - Phase 4 translates topics into other languages, so the TABLE grows.
  //     (Fixed by scoping the count to javascript.)
  //   - Every lesson the Study warm writes after the migration is a new
  //     lesson-with-a-snippet and no javascript row, because the overlay
  //     deliberately never reads one: `getLesson` short-circuits on the corpus
  //     language and serves the stored bytes. So the backfilled rows are a
  //     historical snapshot that legitimately stops being complete.
  //
  // What IS permanently true, and is the failure worth catching, is that no
  // javascript row may DISAGREE with the snippet it was copied from — that is
  // what a translation written into the corpus-language slot would look like,
  // and it is the one way this table could corrupt the shared corpus.
  const jsRows = db.prepare(`SELECT COUNT(*) AS n FROM code_translations WHERE language = ?`).get("javascript").n;
  const drifted = db.prepare(`
    SELECT COUNT(*) AS n FROM code_translations t
    JOIN lessons l ON ? || l.id = t.sourceId
    WHERE t.language = ? AND t.code <> json_extract(l.data, ?)
  `).get("lesson:", "javascript", "$.code").n
    + db.prepare(`
    SELECT COUNT(*) AS n FROM code_translations t
    JOIN pattern_primers p ON ? || p.pattern = t.sourceId
    WHERE t.language = ? AND t.code <> json_extract(p.data, ?)
  `).get("primer:", "javascript", "$.template").n;
  if (drifted === 0) console.log(`  ok   code_translations       ${jsRows} javascript rows, none drifted from the corpus`);
  else { console.log(`  FAIL ${drifted} javascript code_translations row(s) disagree with the stored snippet`); bad++; }

  // Translations of that corpus, per language. Informational — a topic is
  // translated lazily, so any number here is legitimate — but a row addressing
  // a sourceId that no longer exists is not: it is dead weight the overlay will
  // never read, and the sign that a lesson id changed under it.
  const perLang = db.prepare(`
    SELECT language, COUNT(*) AS n FROM code_translations WHERE language <> ? GROUP BY language ORDER BY language
  `).all("javascript");
  console.log(`  ok   translations           ${perLang.length ? perLang.map((r) => `${r.language}=${r.n}`).join(" ") : "(none yet — lazily warmed)"}`);

  // The prefixes are BOUND, never inlined: this whole node program is a
  // single-quoted argument to `node -e`, so a quoted SQL literal would end the
  // shell string. Same reason every other query in this script uses ?.
  const orphans = db.prepare(`
    SELECT COUNT(*) AS n FROM code_translations t
    WHERE NOT EXISTS (SELECT 1 FROM lessons l WHERE ? || l.id = t.sourceId)
      AND NOT EXISTS (SELECT 1 FROM pattern_primers p WHERE ? || p.pattern = t.sourceId)
  `).get("lesson:", "primer:").n;
  if (orphans === 0) console.log(`  ok   translations           every sourceId still resolves`);
  else { console.log(`  FAIL code_translations has ${orphans} row(s) whose sourceId no longer exists`); bad++; }
}

db.close();
process.exit(bad ? 1 : 0);
'
[[ $? -ne 0 ]] && FAILURES=$((FAILURES + 1))

# -----------------------------------------------------------------------------
section "4. API payloads"
# -----------------------------------------------------------------------------
if [[ $DB_ONLY -eq 1 ]]; then
  printf '  skipped (--db-only)\n'
else
  health="$(curl -sS --max-time 10 -o /dev/null -w '%{http_code}' \
    "http://127.0.0.1:${PORT}/api/health" 2>/dev/null)"
  if [[ "$health" != "200" ]]; then
    printf '  INCOMPLETE: the codegrind service is not answering on 127.0.0.1:%s\n' "$PORT"
    printf '              (health probe returned "%s"). This is NOT a migration failure —\n' "${health:-no response}"
    printf '              start it with `sudo systemctl start codegrind`, or re-run with\n'
    printf '              --db-only to check the database alone.\n'
    INCOMPLETE=$((INCOMPLETE + 1))
  else
    compare_endpoint() { # name, url-path, baseline-file, ignore-json
      local name="$1" path="$2" base="$3" ignore="$4"
      local code
      code="$(curl -sS --max-time 30 -o "$TMP/$name.json" -w '%{http_code}' \
        "http://127.0.0.1:${PORT}${path}" 2>/dev/null)"
      if [[ "$code" != "200" ]]; then
        printf '  FAIL %s returned HTTP %s\n' "$path" "${code:-no response}"
        return 1
      fi
      LIVE="$TMP/$name.json" BASE="$base" IGNORE="$ignore" LABEL="$path" node -e '
        const fs = require("node:fs");
        const live = JSON.parse(fs.readFileSync(process.env.LIVE, "utf8"));
        const base = JSON.parse(fs.readFileSync(process.env.BASE, "utf8"));
        const ignore = new Set(JSON.parse(process.env.IGNORE));

        const diffs = [];
        function walk(a, b, path) {
          if (ignore.has(path)) return;
          if (diffs.length > 12) return;
          const prim = (v) => v === null || typeof v !== "object";
          if (prim(a) || prim(b)) {
            if (a !== b) diffs.push(`${path || "/"}: expected ${JSON.stringify(a)}, got ${JSON.stringify(b)}`);
            return;
          }
          if (Array.isArray(a) !== Array.isArray(b)) {
            diffs.push(`${path}: shape changed (array vs object)`);
            return;
          }
          if (Array.isArray(a)) {
            if (a.length !== b.length) diffs.push(`${path}: length ${a.length} -> ${b.length}`);
            for (let i = 0; i < Math.min(a.length, b.length); i++) walk(a[i], b[i], `${path}/${i}`);
            return;
          }
          for (const k of new Set([...Object.keys(a), ...Object.keys(b)])) walk(a[k], b[k], `${path}/${k}`);
        }
        walk(base, live, "");

        if (!diffs.length) {
          console.log(`  ok   ${process.env.LABEL} matches the baseline`);
          process.exit(0);
        }
        console.log(`  FAIL ${process.env.LABEL} differs from the baseline:`);
        for (const d of diffs.slice(0, 12)) console.log(`         ${d}`);
        if (diffs.length > 12) console.log(`         ... and more`);
        process.exit(1);
      '
    }

    compare_endpoint reflect /api/reflect "$BASELINE_DIR/reflect.json" "$REFLECT_IGNORE" \
      || FAILURES=$((FAILURES + 1))
    compare_endpoint progress /api/progress "$BASELINE_DIR/progress.json" "$PROGRESS_IGNORE" \
      || FAILURES=$((FAILURES + 1))
    # bin/capture-baseline has always written these two; comparing them was the
    # missing half. /api/history is the widest read in the app (every attempt,
    # joined to its problem) and /api/study/index is the only one that touches
    # the lesson corpus, which is precisely what code_translations was carved
    # out of.
    compare_endpoint history /api/history "$BASELINE_DIR/history.json" "$HISTORY_IGNORE" \
      || FAILURES=$((FAILURES + 1))
    compare_endpoint study_index /api/study/index "$BASELINE_DIR/study_index.json" "$STUDY_INDEX_IGNORE" \
      || FAILURES=$((FAILURES + 1))
    printf '  note ignored as time-varying: activity window, day streak, reviewDue\n'
  fi
fi

# -----------------------------------------------------------------------------
printf '\n'
if [[ $FAILURES -gt 0 ]]; then
  printf 'FAIL — %d check group(s) disagree with the pre-migration baseline.\n' "$FAILURES"
  exit 1
fi
if [[ $INCOMPLETE -gt 0 ]]; then
  printf 'INCOMPLETE — the database checks passed, but %d check group(s) could not run.\n' "$INCOMPLETE"
  exit 2
fi
printf 'PASS — row counts, clean solves and API payloads all match the baseline.\n'
exit 0
