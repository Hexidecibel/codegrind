#!/usr/bin/env bash
# Deploy codegrind: refresh secrets, install deps, build client, ensure sandbox
# image, restart service. Idempotent — safe to re-run.
set -euo pipefail

# Derived, not hardcoded. Same idiom as bin/build: deploying is the one thing
# most likely to be run from a copy of this tree that is not the author's.
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

# The author's secret tooling. Optional by design — see below — and overridable
# so a checkout that has it somewhere else does not have to edit this script.
INJECT="${CG_INJECT:-${HOME}/local/src/cush-tools/bin/inject}"

# Native modules like better-sqlite3 compile against the ABI of whatever Node
# runs npm — if a shell's default is a different major (e.g. Node 24), the built
# .node fails to load under the service's Node 22 (NODE_MODULE_VERSION
# mismatch). lib/node.sh picks the same Node deploy/codegrind.service pins, so
# install/rebuild target the runtime ABI.
# shellcheck source=lib/node.sh
source "$REPO/bin/lib/node.sh"
cg_require_node

echo "==> Materializing .env via cush-tools inject"
if [[ -x "$INJECT" ]]; then
  "$INJECT" --no-prompt || echo "    (inject non-fatal; continuing)"
else
  echo "    (inject not found at $INJECT; skipping)"
fi

# AFTER inject, because inject rewrites this file. PORT is read the same way
# bin/start and bin/status read it — the health probe below used to be a literal
# 9416, which reports a false failure against an instance moved with --port.
if [[ -f "$REPO/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/.env"
  set +a
fi
PORT="${PORT:-9416}"

# This box has a global npm `omit=dev`, so devDependencies (incl. @types/*, vite,
# tsx) are skipped by a bare install — force them in or the build fails.
echo "==> Installing dependencies (--include=dev)"
npm ci --include=dev || npm install --include=dev

# Typecheck + bundle + precompress. Deps are already installed above.
SKIP_INSTALL=1 "$REPO/bin/build"

echo "==> Ensuring sandbox runner images"
# One image per language now, so ask the languages table rather than hard-coding
# a tag here — a second source of truth for image names is how a deploy ends up
# "ensuring" an image nothing runs.
# shellcheck source=lib/languages.sh
source "$REPO/bin/lib/languages.sh"
#
# PRESENT IS NOT THE SAME AS GOOD, and this loop learned that the hard way. It
# used to accept any image whose tag existed, so when the Go image started
# failing every compiling submission after 24 hours (`go: failed to trim cache`
# — see test-harness/go/Dockerfile) no redeploy could fix it: the tag was there,
# so the deploy called it present and moved on. Each image now has to pass its
# own gate, run with the production sandbox flags, or it is rebuilt. Costs about
# a second per language.
missing=()
while read -r lang; do
  if ! docker image inspect "${CG_IMAGE[$lang]}" >/dev/null 2>&1; then
    echo "    ${CG_IMAGE[$lang]} missing"
    missing+=("$lang")
  elif cg_selftest_image "$lang" >/dev/null 2>&1; then
    echo "    ${CG_IMAGE[$lang]} present, gate passes"
  else
    echo "    ${CG_IMAGE[$lang]} present but FAILS its gate — rebuilding"
    missing+=("$lang")
  fi
done < <(cg_buildable_languages "$REPO")
if [[ ${#missing[@]} -gt 0 ]]; then
  "$REPO/bin/build-runner-image" "${missing[@]}"
fi

echo "==> Ensuring systemd units + the runner reaper timer"
"$REPO/bin/install-units" >/dev/null

echo "==> Restarting service"
sudo systemctl restart codegrind

# systemctl returns as soon as the unit is started, not when the app has bound
# its port — tsx has to boot and compile first. Without this wait, bin/status
# curls a socket that isn't listening yet and reports a false UNREACHABLE.
echo "==> Waiting for health"
for i in $(seq 1 30); do
  if curl -fsS -o /dev/null "http://127.0.0.1:${PORT}/api/health" 2>/dev/null; then
    echo "    ready after ${i}s"
    break
  fi
  if [[ "$i" == "30" ]]; then
    echo "    still not healthy after 30s — see bin/logs" >&2
  fi
  sleep 1
done

echo "==> Status"
# Was `exec bin/status`; now a plain call so the tip below still prints. Its exit
# code is preserved and re-raised at the end so deploy's semantics are unchanged.
status_rc=0
"$REPO/bin/status" || status_rc=$?

# Deliberately NOT run automatically: every LLM call in this app is user-initiated,
# so idle cost stays $0. Warming is opt-in.
echo "==> Tip: run bin/warm-lessons to pre-generate Study lessons (uses the Claude API)."
exit "$status_rc"
