#!/usr/bin/env bash
# Reset LEARNER state (attempts, sessions, review queue, per-topic skill state)
# while KEEPING the generated problem bank and pattern primers — so a fresh start
# reflects real performance without re-paying generation cost. Safe on the live
# DB (WAL). Run: bin/reset-progress
set -euo pipefail

# Derived, not hardcoded — this used to be the literal author's path, so on any
# other machine it wiped nothing, or wiped the wrong thing. Same idiom as
# bin/build and every other entry point.
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

# better-sqlite3 is ABI-pinned; lib/node.sh finds a Node that will not crash it.
# shellcheck source=lib/node.sh
source "$REPO_DIR/bin/lib/node.sh"
cg_require_node

# DATA_DIR lives in .env for a CLI run; without this the wipe targets ./data
# even on an install that keeps its database somewhere else.
if [[ -f "$REPO_DIR/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO_DIR/.env"
  set +a
fi

DB="${DATA_DIR:-$REPO_DIR/data}/codegrind.db"
case "$DB" in /*) ;; *) DB="$REPO_DIR/${DB#./}" ;; esac

# The path goes through the environment rather than being spliced into the
# program text: this whole thing is one single-quoted bash argument, and a
# directory with a quote or a space in it used to produce a syntax error.
DB="$DB" node -e '
const Database = require("better-sqlite3");
const db = new Database(process.env.DB);
const wipe = ["attempts","sessions","review_queue","skill_state"];
const kept = ["problems","pattern_primers"];
db.pragma("foreign_keys = OFF");
for (const t of wipe) {
  try { const n = db.prepare(`DELETE FROM ${t}`).run().changes; console.log(`cleared ${t}: ${n} rows`); }
  catch (e) { console.log(`skip ${t}: ${e.message}`); }
}
// Re-make the whole banked set available so a fresh start serves instantly
// (otherwise all-used problems force a ~15s generate on the first grind).
try { const n = db.prepare("UPDATE problems SET used=0").run().changes; console.log(`freed problems (used=0): ${n}`); }
catch (e) { console.log(`skip un-use: ${e.message}`); }
for (const t of kept) {
  try { const n = db.prepare(`SELECT COUNT(*) c FROM ${t}`).get().c; console.log(`kept ${t}: ${n} rows`); }
  catch {}
}
db.close();
'
echo "done"
