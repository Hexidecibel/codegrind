# Dependencies
node_modules

# Build
dist
dist-ssr
*.local
tsconfig.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Environment
.env
# The scratch instance's config (bin/scratch). Same rules as .env: never committed.
.env.scratch

# Data (SQLite DB + sandbox scratch)
data/
# The scratch instance's own database — a second, disposable install (bin/scratch)
data-scratch/

# Author secret-management manifest. Local tooling only; a fresh clone neither
# needs nor uses it, and it must never be tracked again (it named an internal
# vault path and revealed which projects share one key).
.cush-secrets

# The author's direnv hook: refreshes .env from cush-tools secret tooling on cd.
# NOT part of the product. It hardcodes a path that only exists on one machine,
# and `dotenv` is a direnv builtin, so the file is inert-to-broken anywhere else.
# Shipping it meant every clone with direnv installed opened on a red
# ".envrc is blocked" error before bin/setup was even run.
.envrc
