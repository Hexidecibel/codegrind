## =============================================================================
## TEMPLATE — rendered and installed by bin/install-units, never copied verbatim.
## See codegrind.service for what each @PLACEHOLDER@ is and where it comes from.
## `##` lines are stripped on render; plain `#` comments are kept.
## =============================================================================
[Unit]
Description=codegrind — reap orphaned sandbox runner containers
Documentation=file://@CODEGRIND_REPO@/bin/reap-runners
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Same user as codegrind.service: that user is in the docker group, so no sudo
# and no root. A reaper that needed root to clean up after an unprivileged
# service would be a larger blast radius than the problem it solves.
User=@CODEGRIND_USER@
WorkingDirectory=@CODEGRIND_REPO@
ExecStart=@CODEGRIND_REPO@/bin/reap-runners
# A docker daemon hiccup must not wedge the timer: oneshot units block the next
# activation until they exit.
TimeoutStartSec=120
